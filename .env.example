# Copy to .env and fill in. .env is gitignored; this file is not.
# A fresh clone or a git worktree has NO .env — init.sh fails loudly if it is missing.

# Supabase PostgreSQL — direct connection, port 5432, as the OWNER. Only three things use
# it: seed/seed_demo_data.py, init.sh's smoke test, and app/db/roles.sql, which mints the two
# roles below. No application module reads it — SPEC §3.1's split is the whole point.
SUPABASE_DB_URL_DIRECT=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres

# The ANALYSIS path — profiling, identifier validation, rule execution. `dq_analyst` holds
# SELECT on the tables under analysis and no other privilege anywhere, so a write to `orders`
# is refused by PostgreSQL rather than by our code. Created by app/db/roles.sql.
SUPABASE_DB_URL_ANALYSIS=postgresql://dq_analyst:PASSWORD@db.PROJECT.supabase.co:5432/postgres

# The RULE STORE. `dq_system` owns the system schema and may write there; it is granted
# nothing at all on `public`, so it is refused a write to `orders` too — the store never had
# a reason to hold that power. Created by app/db/roles.sql.
SUPABASE_DB_URL_SYSTEM=postgresql://dq_system:PASSWORD@db.PROJECT.supabase.co:5432/postgres

# Supabase PostgreSQL — pooled connection, port 6543. NOT used for rule execution: LT-1b
# measured the transaction pooler 21% slower on identical work (17.94 s vs 14.84 s). Kept for
# comparison runs only; F8 uses SUPABASE_DB_URL_DIRECT.
SUPABASE_DB_URL_POOLED=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# The system's own schema — where rules and run records live, never the tables under
# analysis. Optional; defaults to `dq`, which is why the line below is commented out.
# tests/conftest.py OVERRIDES it to a scratch schema for every check, whatever is set
# here: the rule store is append-only, so a check that wrote here could never tidy up.
#DQ_SCHEMA=dq

# The port app/api/server.py listens on — the one process that holds the single Great
# Expectations context (INV-3) and streams a run's verdicts as they land (F8). Optional;
# defaults to 8000, which is why the line below is commented out.
#DQ_API_PORT=8000

# Where the Next app (web/) and the browser checks find that process. Read SERVER-SIDE only —
# `web/app/api.ts` calls it from Server Components, so the browser never talks to Python and
# there is no CORS, no second origin and no API base URL in the bundle. Optional; defaults to
# http://localhost:8000, which is why the line below is commented out.
#DQ_API_URL=http://localhost:8000

# Claude subscription token for the Agent SDK. No ANTHROPIC_API_KEY, no `ant` CLI.
# Read today only by learning-tests/lt2b_agent_sdk.py, so init.sh does NOT require it.
CLAUDE_CODE_OAUTH_TOKEN=
