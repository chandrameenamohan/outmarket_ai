# Copy to .env and fill in. .env is gitignored; this file is not.
# A fresh clone or a git worktree has NO .env — init.sh fails loudly if it is missing.

# Supabase PostgreSQL — direct connection, port 5432. What the scripts and the gate assert on.
SUPABASE_DB_URL_DIRECT=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres

# Supabase PostgreSQL — pooled connection, port 6543. NOT used for rule execution: LT-1b
# measured the transaction pooler 21% slower on identical work (17.94 s vs 14.84 s). Kept for
# comparison runs only; F8 uses SUPABASE_DB_URL_DIRECT.
SUPABASE_DB_URL_POOLED=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Claude subscription token for the Agent SDK. No ANTHROPIC_API_KEY, no `ant` CLI.
# Read today only by learning-tests/lt2b_agent_sdk.py, so init.sh does NOT require it.
CLAUDE_CODE_OAUTH_TOKEN=
